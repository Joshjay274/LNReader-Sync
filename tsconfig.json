{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2020"],
    "types": ["react", "react-native"]
  },
  "include": ["App.tsx", "src/**/*"],
  "exclude": ["node_modules", "android", "ios", "build"]
}
