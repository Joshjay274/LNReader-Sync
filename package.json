{
  "name": "lnreader-sync",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "react-native run-android --variant=debug",
    "android:release": "cd android && ./gradlew assembleRelease && cd ..",
    "android:signed": "cd android && ./gradlew bundleRelease && cd ..",
    "build:apk": "bash scripts/build-apk.sh",
    "sign:apk": "bash scripts/sign-apk.sh",
    "install:apk": "bash scripts/install-apk.sh",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*\"'
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-firebase/app": "^21.0.0",
    "@react-native-firebase/auth": "^21.0.0",
    "@react-native-firebase/firestore": "^21.0.0",
    "@react-native-firebase/storage": "^21.0.0",
    "@react-native-google-signin/google-signin": "^13.0.0",
    "@react-navigation/bottom-tabs": "^6.1.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.1.0",
    "react": "18.2.0",
    "react-native": "0.73.5",
    "react-native-safe-area-context": "^4.5.0",
    "react-native-screens": "^3.15.0",
    "uuid": "^9.0.0",
    "zustand": "^4.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@types/react": "^18.2.66",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-jest": "^29.6.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "jest": "^29.6.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
