# LNReader Sync - Cloud Storage Security Rules

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to upload and manage their own files
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Public novel covers and assets (read-only for authenticated users)
    match /novels/{novelId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    
    // Collection covers and assets
    match /collections/{collectionId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    
    // Temporary uploads
    match /temp/{uid}/{allPaths=**} {
      allow read, write: if request.auth.uid == uid && request.time < timestamp.date(2024, 12, 31);
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
