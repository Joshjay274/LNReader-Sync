# LNReader Sync - Firebase Firestore Security Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to manage their own data only
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
      
      // User profile
      match /profile/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // Reading progress for individual books
      match /readingProgress/{document=**} {
        allow read, write: if request.auth.uid == userId;
        allow list: if request.auth.uid == userId;
      }
      
      // Bookmarks
      match /bookmarks/{document=**} {
        allow read, write: if request.auth.uid == userId;
        allow list: if request.auth.uid == userId;
      }
      
      // Notes and annotations
      match /notes/{document=**} {
        allow read, write: if request.auth.uid == userId;
        allow list: if request.auth.uid == userId;
      }
      
      // User preferences and settings
      match /settings/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // Library collection
      match /library/{document=**} {
        allow read, write: if request.auth.uid == userId;
        allow list: if request.auth.uid == userId;
      }
      
      // Sync metadata
      match /sync/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // Public novel catalog (read-only for authenticated users)
    match /novels/{novelId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
      allow list: if request.auth != null;
      
      // Chapter data
      match /chapters/{chapterId} {
        allow read: if request.auth != null;
        allow write: if request.auth.token.admin == true;
      }
      
      // Novel metadata
      match /metadata/{document=**} {
        allow read: if request.auth != null;
      }
    }
    
    // Public collections catalog
    match /collections/{collectionId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
